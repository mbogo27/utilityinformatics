---
import { site, whatsappUrl } from "../lib/site";
---
<footer class="site-footer on-ink">
  <div class="wrap top">
    <div class="brand">
      <img src="/images/logo.png" alt={site.name} width="120" height="65" />
      <p>{site.tagline}.</p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {site.nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>
    <address>
      <a href={whatsappUrl()} rel="noopener">Chat on WhatsApp</a>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      <a href={site.social.facebook} rel="noopener" target="_blank" class="social">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M22 12.06C22 6.48 17.52 2 11.94 2S2 6.48 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.84c0-2.51 1.49-3.9 3.77-3.9 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94z"/>
        </svg>
        Follow us on Facebook
      </a>
    </address>
  </div>
  <div class="wrap legal">© {new Date().getFullYear()} {site.name}. All rights reserved.</div>
</footer>
<style>
  .site-footer { border-top: 1px solid var(--gold); padding-top: 56px; }
  .top { display: grid; grid-template-columns: 1.2fr 1fr 1.4fr; gap: 40px; padding-bottom: 48px; }
  .brand img { height: 64px; width: auto; margin-bottom: 8px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  a { text-decoration: none; color: var(--white); transition: color 0.15s; }
  a:hover { color: var(--gold-bright); }
  address { font-style: normal; display: grid; gap: 10px; align-content: start; color: var(--stone-on-ink); }
  address a { color: var(--white); }
  .social { display: inline-flex; align-items: center; gap: 8px; }
  .legal { border-top: 1px solid var(--line-on-ink); padding-block: 20px; font-size: 0.875rem; color: var(--stone-on-ink); }
  @media (max-width: 760px) { .top { grid-template-columns: 1fr; } }
</style>

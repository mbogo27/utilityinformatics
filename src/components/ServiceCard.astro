---
interface Props {
  title: string;
  summary: string;
  steps?: { title: string; body: string }[];
  dark?: boolean;
}
const { title, summary, steps, dark = false } = Astro.props;
---
<article class:list={["svc", { dark }]}>
  <h3>{title}</h3>
  <p class="sum">{summary}</p>
  {steps && steps.length > 0 && (
    <ul class="steps">
      {steps.map((s) => (
        <li><strong>{s.title}</strong><span>{s.body}</span></li>
      ))}
    </ul>
  )}
</article>
<style>
  .svc { background: var(--white); border: 1px solid var(--line); padding: 28px; transition: border-color 0.15s; }
  .svc:hover { border-color: var(--gold); }
  .svc.dark { background: transparent; border-color: var(--line-on-ink); }
  .svc.dark:hover { border-color: var(--gold-bright); }
  h3 { margin-bottom: 12px; }
  .sum { color: var(--stone); }
  .dark .sum { color: var(--stone-on-ink); }
  .steps { list-style: none; margin: 24px 0 0; padding: 0; display: grid; gap: 14px; }
  .steps li { display: grid; gap: 2px; padding-left: 16px; border-left: 2px solid var(--gold); }
  .steps strong { font-weight: 600; font-size: 0.9375rem; }
  .steps span { font-size: 0.9375rem; color: var(--stone); }
  .dark .steps span { color: var(--stone-on-ink); }
</style>

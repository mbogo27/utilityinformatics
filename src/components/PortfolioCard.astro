---
interface Props {
  name: string;
  url: string;
  description: string;
  related?: string[];
  image: string;
  compact?: boolean;
  linkLabel?: string;
}
const { name, url, description, related, image, compact = false, linkLabel } = Astro.props;
let label = linkLabel;
if (!label) {
  try {
    label = new URL(url).host;
  } catch {
    label = "View";
  }
}
---
<article class:list={["pcard", { compact }]}>
  <div class="shot"><img src={image} alt="" loading="lazy" /></div>
  <div class="body">
    <h3>{name}</h3>
    <p>{description}</p>
    {related && related.length > 0 && <p class="rel">Related services: {related.join(", ")}.</p>}
    <a class="link" href={url} rel="noopener" target="_blank">{label}</a>
  </div>
</article>
<style>
  .pcard { display: grid; grid-template-columns: 1fr 1fr; background: var(--white); border: 1px solid var(--line); transition: border-color 0.15s; }
  .pcard:hover { border-color: var(--gold); }
  .pcard.compact { grid-template-columns: 1fr; }
  .shot { position: relative; min-height: 300px; overflow: hidden; background: var(--paper); }
  .compact .shot { min-height: 0; aspect-ratio: 16 / 10; }
  img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: top left; }
  .body { padding: 32px; display: grid; gap: 14px; align-content: center; justify-items: start; }
  .body p { color: var(--stone); }
  .rel { font-size: 0.9375rem; }
  @media (max-width: 760px) { .pcard { grid-template-columns: 1fr; } }
</style>
